# Public browser configuration. Copy this file to .env.local for local development.
# Use a staging project while testing the security migration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Alternatively use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for modern public keys.
# Never put a database password, service-role key, or secret key in NEXT_PUBLIC_*.

# Exact public origin for origin checks. Use the real HTTPS origin in production.
SITE_URL=http://localhost:3000
# Emergency app pause. Also disable writes in private.marketplace_settings to
# pause direct database API writes. Read docs/OPERATIONS.md before changing it.
MARKETPLACE_WRITES_ENABLED=true
